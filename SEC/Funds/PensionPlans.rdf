	xmlns:skos="http://www.w3.org/2004/02/skos/core#"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
	
	<owl:Ontology rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/PensionPlans/">
		<rdfs:label xml:lang="en">Pension Plans Ontology</rdfs:label>
		<dct:abstract>This ontology defines fundamental concepts about pension plans, and in particular, private pension plans, based on part on the classification and glossary of private pension systems developed by the OECD.</dct:abstract>
		<dct:contributor>Intuitive Technology Partners Inc.</dct:contributor>
		<dct:contributor>John F. Gemski</dct:contributor>
		<dct:contributor>ProBanker Simulations, LLC</dct:contributor>
		<dct:contributor>T. Rowe Price</dct:contributor>
		<dct:contributor>Tahoe Blue</dct:contributor>
		<dct:contributor>Thematix Partners LLC</dct:contributor>
		<dct:license>Copyright (c) 2026 EDM Association dba EDM Council, Inc.

