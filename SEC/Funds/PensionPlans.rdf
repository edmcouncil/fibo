		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/Funds/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Classifiers/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Designators/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Documents/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Organizations/"/>
		<owl:versionIRI rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/PensionPlans/"/>
		<fibo-fnd-utl-av:hasMaturityLevel rdf:resource="&fibo-fnd-utl-av;Provisional"/>
		<cmns-av:copyright>Copyright (c) 2026 EDM Association dba EDM Council, Inc.</cmns-av:copyright>
	</owl:Ontology>
	
	<owl:Class rdf:about="&fibo-sec-fund-fund;PensionFund">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;providesFundingFor"/>
				<owl:someValuesFrom rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<cmns-av:explanatoryNote>A pension fund is the pool of assets, typically forming an independent legal entity, that are bought with the contributions to a pension plan for the exclusive purpose of financing pension plan benefits. The plan/fund members have a legal or beneficial right or some other contractual claim against the assets of the pension fund. Pension funds take the form of either a special purpose entity with legal personality (such as a trust, foundation, or corporate entity) or a legally separated fund without legal personality managed by a dedicated provider (pension fund management company) or other financial institution on behalf of the plan/fund members.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;BookReservedPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
		<rdfs:label>book reserved pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;FundedPensionPlan"/>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;UnfundedPensionPlan"/>
		<skos:definition>pension plan sums whose balance sheet reflects sums entered in the balance sheet of the plan sponsor as reserves or provisions for occupational pension plan benefits</skos:definition>
		<skos:note>Some assets may be held in separate accounts for the purpose of financing benefits, but are not legally or contractually pension plan assets. Most OECD countries do not allow this method of financing. Those that do usually require these plans to be insured against bankruptcy of the plan sponsor through an insolvency guaranty arrangement.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;ClosedPensionFund">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-fund;ClosedEndInvestment"/>
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-fund;PensionFund"/>
		<rdfs:label>closed pension fund</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>pension fund that supports only pension plans that are limited to certain employees</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;OccupationalPensionPlan"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&cmns-cls;isClassifiedBy"/>
				<owl:someValuesFrom rdf:resource="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlanClassifier"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>defined benefit occupational pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;DefinedContributionOccupationalPensionPlan"/>
		<skos:definition>occupational pension plan other than defined contributions plans</skos:definition>
		<cmns-av:abbreviation>DB</cmns-av:abbreviation>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlanClassifier">
		<rdfs:subClassOf rdf:resource="&cmns-cls;Classifier"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&cmns-cls;classifies"/>
				<owl:someValuesFrom rdf:resource="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>defined benefit occupational pension plan classifier</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>classifier for  occupational plans other than defined contributions plans</skos:definition>
		<skos:note>DB plans generally can be classified into one of three main types, &apos;traditional&apos;, &apos;mixed&apos; and &apos;hybrid&apos; plans.</skos:note>
	</owl:Class>
	
	<owl:NamedIndividual rdf:about="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlanClassifier-Hybrid">
		<rdf:type rdf:resource="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlanClassifier"/>
		<rdfs:label>defined benefit occupational pension plan classifier - hybrid</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>classifier for DB plans where benefits depend on a rate of return credited to contributions, where this rate of return is either specified in the plan rules, independently of the actual return on any supporting assets (e.g. fixed, indexed to a market benchmark, tied to salary or profit growth, etc.), or is calculated with reference to the actual return of any supporting assets and a minimum return guarantee specified in the plan rules</skos:definition>
		<cmns-dsg:hasTag>hybrid</cmns-dsg:hasTag>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlanClassifier-Mixed">
		<rdf:type rdf:resource="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlanClassifier"/>
		<rdfs:label>defined benefit occupational pension plan classifier - mixed</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>classifier for DB plans that have two separate DB and DC components but which are treated as part of the same plan</skos:definition>
		<cmns-dsg:hasTag>mixed</cmns-dsg:hasTag>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlanClassifier-Traditional">
		<rdf:type rdf:resource="&fibo-sec-fund-pp;DefinedBenefitOccupationalPensionPlanClassifier"/>
		<rdfs:label>defined benefit occupational pension plan classifier - traditional</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>classifier for DB plans where benefits are linked through a formula to the members&apos; wages or salaries, length of employment, or other factors</skos:definition>
		<cmns-dsg:hasTag>traditional</cmns-dsg:hasTag>
	</owl:NamedIndividual>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;DefinedContributionOccupationalPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;OccupationalPensionPlan"/>
		<rdfs:label>defined contribution occupational pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>occupational pension plan under which the plan sponsor pays fixed contributions and has no legal or constructive obligation to pay further contributions to an ongoing plan in the event of unfavourable plan experience</skos:definition>
		<skos:note>The IASB&apos;s definition of constructive obligations in pension markets is defined in IAS 37 as an obligation that derives from an entity&apos;s actions where: a) by an established pattern of past practice, published policies or a sufficiently specific current standard, the entity has indicated to other parties that it will accept responsibilities; and, b) as a result, the entity has created a valid expectation on the part of those other parties that it will discharge those responsibilities.</skos:note>
		<cmns-av:abbreviation>DC</cmns-av:abbreviation>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;FundedPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
		<rdfs:label>funded pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;UnfundedPensionPlan"/>
		<skos:definition>pension plan that accumulates dedicated assets to cover the plan&apos;s liabilities</skos:definition>
		<cmns-av:explanatoryNote>These assets are assigned by law or contract to the pension plan. Their use is restricted to the payment of pension plan benefits.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;IndividualPensionAccount">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;IndividualRetirementAccount"/>
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionAccount"/>
		<rdfs:label>individual pension account</rdfs:label>
		<skos:definition>pension account in which amounts attributable to an individual are recorded</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;IndividualPensionFund">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;ClosedPensionFund"/>
		<rdfs:label>individual pension fund</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;SingleEmployerPensionFund"/>
		<skos:definition>pension fund that comprises the assets of a single member and his/her beneficiaries, usually in the form of an individual account</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;IndividualRetirementAccount">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;RetirementAccount"/>
		<rdfs:label>individual retirement account</rdfs:label>
		<skos:definition>retirement account in which amounts attributable to an individual are recorded</skos:definition>
		<skos:note>An individual retirement account may be established pursuant to a pension plan, or it may be established independently.</skos:note>
		<cmns-av:explanatoryNote>The term &apos;individual retirement account&apos; is also the designation of a particular U.S. legal/tax concept, Individual Retirement Account (IRA). This class represents the more general notion of an individual account established by an individual for the purposes of managing funds designated for retirement purposes.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;MandatoryOccupationalPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;OccupationalPensionPlan"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;isMandatory"/>
				<owl:hasValue rdf:datatype="&xsd;boolean">true</owl:hasValue>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>mandatory occupational pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>occupational pension plan for which participation is mandatory for employers</skos:definition>
		<skos:note>Some employers are obliged by law to participate in a pension plan, depending on the jurisdiction. In such cases, employers must set up (and make contributions to) occupational pension plans which employees will normally be required to join. Where employers are obliged to offer an occupational pension plan, but the employees&apos; membership is on a voluntary basis, these plans are also considered mandatory.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;MandatoryPersonalPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PersonalPensionPlan"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;isMandatory"/>
				<owl:hasValue rdf:datatype="&xsd;boolean">true</owl:hasValue>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>mandatory personal pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>personal pension plan that individuals must join or that are eligible to receive mandatory pension contributions</skos:definition>
		<skos:note>Individuals may be required to make pension contributions to a pension plan of their choice - normally within a certain range of choices - or to a specific pension plan.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;MultiEmployerPensionFund">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;ClosedPensionFund"/>
		<rdfs:label>multi-employer pension fund</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;IndividualPensionFund"/>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;RelatedMemberPensionFund"/>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;SingleEmployerPensionFund"/>
		<skos:definition>pension fund that pools the assets of pension plans established by various plan sponsors</skos:definition>
		<cmns-av:explanatoryNote>There are three types of multi-employer pension funds: a) for related employers i.e. companies that are financially connected or owned by a single holding group (group pension funds); b) for unrelated employers who are involved in the same trade or business (industry pension funds); c) for unrelated employers that may be in different trades or businesses (collective pension funds).</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;OccupationalPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
		<rdfs:label>occupational pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>pension plan linked to an employment or professional relationship between the plan member and the entity that establishes the plan (the plan sponsor)</skos:definition>
		<skos:note>Occupational plans may be established by employers or groups thereof (e.g. industry associations) and labour or professional associations, jointly or separately. The plan may be administered directly by the plan sponsor or by an independent entity (a pension fund or a financial institution acting as pension provider). In the latter case, the plan sponsor may still have oversight responsibilities over the operation of the plan.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;OpenPensionFund">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-fund;OpenEndInvestment"/>
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-fund;PensionFund"/>
		<rdfs:label>open pension fund</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;ClosedPensionFund"/>
		<skos:definition>pension fund that supports at least one plan with no restriction on membership</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PensionAccount">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;RetirementAccount"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&cmns-doc;isSpecifiedIn"/>
				<owl:someValuesFrom rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>pension account</rdfs:label>
		<skos:definition>retirement account in which amounts associated with a pension plan are recorded</skos:definition>
		<skos:editorialNote>Could create new properties for &apos;is account of&apos;/&apos;has account&apos; for the relationship between the account and the plan instead of using specifies/is specified in.</skos:editorialNote>
		<skos:editorialNote>Need to determine how/whether to link an account to any specific interest in a given pension fund - percentage ownership, number of shares ... maybe that the account records an interest in the fund?</skos:editorialNote>
		<skos:note>A pension account may record (1) a monetary balance, (2) units in a pooled investment, (3) contributions and earnings, (4)  accrued benefits, (5) a notional amount, or (6) some combination thereof. Thus, the relationship with a particular fund is optional, and may record an interest in multiple funds, depending on the plan.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PensionInsuranceContract">
		<rdfs:subClassOf rdf:resource="&fibo-fbc-dae-gty;InsurancePolicy"/>
		<rdfs:label>pension insurance contract</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>insurance contract that specifies pension plan contributions to an insurance undertaking in exchange for which the pension plan benefits will be paid when the members reach a specified retirement age or on earlier exit of members from the plan</skos:definition>
		<skos:note>Most countries limit the integration of pension plans only into pension funds, as the financial vehicle of the pension plan. Other countries also consider the pension insurance contract as the financial vehicle for pension plans.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-fnd-agr-ctr;WrittenContract"/>
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;RetirementArrangement"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;isFundedBy"/>
				<owl:onClass rdf:resource="&fibo-sec-fund-fund;PensionFund"/>
				<owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">0</owl:minQualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;isUnprotected"/>
				<owl:onDataRange rdf:resource="&xsd;boolean"/>
				<owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&cmns-doc;specifies"/>
				<owl:someValuesFrom rdf:resource="&fibo-sec-fund-pp;PensionAccount"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>legally binding contract having an explicit retirement objective or - in order to satisfy tax related conditions or contract provisions - the benefits can not be paid at all or without a significant penalty unless the beneficiary is older than a legally defined retirement age</skos:definition>
		<cmns-av:explanatoryNote>A pension plan is a retirement arrangement that establishes conditions for contributions, accrual of pension benefits, or provision of pension benefits to members or beneficiaries, in other words.</cmns-av:explanatoryNote>
		<cmns-av:explanatoryNote>This contract may be part of a broader employment contract, it may be set forth in the plan rules or documents, or it may be required by law. The elements of the pension plan may be mandated by law or statute or set forth as pre-requisites for special tax treatment, as is the case for many tax qualified savings or retirement programmes designed to provide the plan&apos;s members and beneficiaries with an income after retirement. In addition to having an explicit retirement objective, pension plans may offer additional benefits, such as disability, sickness, and survivors benefits.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PersonalPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
		<rdfs:label>personal pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;OccupationalPensionPlan"/>
		<skos:definition>pension plan that does not need to be linked to an employment or professional relationship</skos:definition>
		<skos:note>Personal plans are established and administered directly by a pension fund or a financial institution acting as pension provider without any intervention of employers. Individuals independently purchase and select material aspects of the arrangements. The employer may nonetheless make contributions to personal pension plans. Some personal plans may have restricted membership.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PrivatePensionFund">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-fund;PensionFund"/>
		<rdfs:label>private pension fund</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;PublicPensionFund"/>
		<skos:definition>pension fund that is regulated under private sector law</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PrivatePensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;isMandatory"/>
				<owl:onDataRange rdf:resource="&xsd;boolean"/>
				<owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>private pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;PublicPensionPlan"/>
		<skos:definition>pension plan administered by an institution other than general government</skos:definition>
		<skos:note>Private pension plans may be administered directly by a private sector employer acting as the plan sponsor, a private pension fund substitute for public pension plans. In some countries, these may include plans for public sector workers.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PublicPensionFund">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-fund;PensionFund"/>
		<rdfs:label>public pension fund</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>pension fund that is regulated under public sector law</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PublicPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
		<rdfs:label>public pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>pension plan administered by the general government (that is central, state, and local governments, as well as other public sector bodies such as social security institutions)</skos:definition>
		<skos:note>Public pension plans have been traditionally PAYG-financed, but some OECD countries have partial funding of public pension liabilities or have replaced these plans by private pension plans.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;RelatedMemberPensionFund">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;ClosedPensionFund"/>
		<rdfs:label>related member pension fund</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;IndividualPensionFund"/>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;SingleEmployerPensionFund"/>
		<skos:definition>pension fund that comprises the assets of a limited number of related members who are all in the governing body of the pension fund</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;RetirementAccount">
		<rdfs:subClassOf rdf:resource="&fibo-fbc-pas-caa;InvestmentAccount"/>
		<rdfs:label>retirement account</rdfs:label>
		<skos:definition>account in which amounts intended to provide income or financial resources during retirement are recorded</skos:definition>
		<skos:note>The term &apos;amounts&apos; is used intentionally here as the account is the record, not necessarily the assets themselves, and because &apos;amounts&apos; can encompass balances or entitlements that do not correspond to a separately segregated pool of assets.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;RetirementArrangement">
		<rdfs:subClassOf rdf:resource="&fibo-fnd-agr-agr;Agreement"/>
		<rdfs:label>retirement arrangement</rdfs:label>
		<skos:definition>arrangement that establishes conditions for the accumulation or provision of financial resources for retirement</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;SingleEmployerPensionFund">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;ClosedPensionFund"/>
		<rdfs:label>single employer pension fund</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>pension fund that pools the assets of pension plans established by a single sponsor</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;UnfundedPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
		<rdfs:label>unfunded pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>pension plan that is financed directly from contributions from the plan sponsor or provider and/or the plan participant</skos:definition>
		<skos:note>Unfunded pension plans are said to be paid on a current disbursement method (also known as the pay-as-you-go, PAYG, method). Unfunded plans may still have associated reserves to cover immediate expenses or smooth contributions within given time periods. Most OECD countries do not allow unfunded private pension plans.</skos:note>
		<cmns-av:abbreviation>PAYG</cmns-av:abbreviation>
		<cmns-av:synonym>PAYG pension plan</cmns-av:synonym>
		<cmns-av:synonym>pay-as-you-go pension plan</cmns-av:synonym>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;VoluntaryOccupationalPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;OccupationalPensionPlan"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;isMandatory"/>
				<owl:hasValue rdf:datatype="&xsd;boolean">false</owl:hasValue>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>voluntary occupational pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;MandatoryOccupationalPensionPlan"/>
		<skos:definition>occupational pension plan for which establishment is voluntary for employers (including those in which there is automatic enrollment as part of an employment contract or where the law requires employees to join plans set up on a voluntary basis by their employers)</skos:definition>
		<skos:note>In some countries, employers can on a voluntary basis establish occupational plans that provide benefits that replace at least partly those of the social security system. These plans are classified as voluntary, even though employers must continue sponsoring these plans in order to be exempted (at least partly) from social security contributions.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;VoluntaryPersonalPensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PersonalPensionPlan"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;isMandatory"/>
				<owl:hasValue rdf:datatype="&xsd;boolean">false</owl:hasValue>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>voluntary personal pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:disjointWith rdf:resource="&fibo-sec-fund-pp;MandatoryPersonalPensionPlan"/>
		<skos:definition>personal pension plan in which participation is voluntary for individuals</skos:definition>
		<skos:note>By law individuals are not obliged to participate in a pension plan. They are not required to make pension contributions to a pension plan. Voluntary personal plans include those plans that individuals must join if they choose to replace part of their social security benefits with those from personal pension plans.</skos:note>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&fibo-sec-fund-pp;isFundedBy">
		<rdfs:subPropertyOf rdf:resource="&cmns-org;isProvidedBy"/>
		<rdfs:label xml:lang="en">is funded by</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<owl:inverseOf rdf:resource="&fibo-sec-fund-pp;providesFundingFor"/>
		<skos:definition xml:lang="en">indicates a plan or fund to an agreement or other funding arrangement that funds it</skos:definition>
	</owl:ObjectProperty>
	
	<owl:DatatypeProperty rdf:about="&fibo-sec-fund-pp;isMandatory">
		<rdfs:label xml:lang="en">is mandatory</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<rdfs:range rdf:resource="&xsd;boolean"/>
		<skos:definition xml:lang="en">indicates, if true, that something is required under some conditions</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="&fibo-sec-fund-pp;isUnprotected">
		<rdfs:label xml:lang="en">is unprotected</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<rdfs:range rdf:resource="&xsd;boolean"/>
		<skos:definition xml:lang="en">indicates, if true, that the pension plan/fund itself or the pension provider does not offer any investment return or benefit guarantees or promises covering the whole plan/fund</skos:definition>
	</owl:DatatypeProperty>
	
	<owl:ObjectProperty rdf:about="&fibo-sec-fund-pp;providesFundingFor">
		<rdfs:subPropertyOf rdf:resource="&cmns-org;provides"/>
		<rdfs:label xml:lang="en">provides funding for</rdfs:label>
		<owl:inverseOf rdf:resource="&fibo-sec-fund-pp;isFundedBy"/>
		<skos:definition xml:lang="en">relates an agreement or funding arrangement to something that funds it</skos:definition>
	</owl:ObjectProperty>

</rdf:RDF>