		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/Pools/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Collections/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Documents/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Locations/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/Organizations/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/RegulatoryAgencies/"/>
		<owl:versionIRI rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/PensionPlans/"/>
		<fibo-fnd-utl-av:hasMaturityLevel rdf:resource="&fibo-fnd-utl-av;Provisional"/>
		<cmns-av:copyright>Copyright (c) 2026 EDM Association dba EDM Council, Inc.</cmns-av:copyright>
	</owl:Ontology>
	
	<owl:Class rdf:about="&fibo-sec-fund-fund;PensionFund">
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;providesFundingFor"/>
				<owl:someValuesFrom rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;IndividualPensionAccount">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;IndividualRetirementAccount"/>
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;PensionAccount"/>
		<rdfs:label>individual pension account</rdfs:label>
		<skos:definition>pension account in which amounts attributable to an individual are recorded</skos:definition>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;IndividualRetirementAccount">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;RetirementAccount"/>
		<rdfs:label>individual retirement account</rdfs:label>
		<skos:definition>retirement account in which amounts attributable to an individual are recorded</skos:definition>
		<skos:note>An individual retirement account may be established pursuant to a pension plan, or it may be established independently.</skos:note>
		<cmns-av:explanatoryNote>The term &apos;individual retirement account&apos; is also the designation of a particular U.S. legal/tax concept, Individual Retirement Account (IRA). This class represents the more general notion of an individual account established by an individual for the purposes of managing funds designated for retirement purposes.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PensionAccount">
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;RetirementAccount"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&cmns-doc;isSpecifiedIn"/>
				<owl:someValuesFrom rdf:resource="&fibo-sec-fund-pp;PensionPlan"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>pension account</rdfs:label>
		<skos:definition>retirement account in which amounts associated with a pension plan are recorded</skos:definition>
		<skos:editorialNote>Could create new properties for &apos;is account of&apos;/&apos;has account&apos; for the relationship between the account and the plan instead of using specifies/is specified in.</skos:editorialNote>
		<skos:editorialNote>Need to determine how/whether to link an account to any specific interest in a given pension fund - percentage ownership, number of shares ... maybe that the account records an interest in the fund?</skos:editorialNote>
		<skos:note>A pension account may record (1) a monetary balance, (2) units in a pooled investment, (3) contributions and earnings, (4)  accrued benefits, (5) a notional amount, or (6) some combination thereof. Thus, the relationship with a particular fund is optional, and may record an interest in multiple funds, depending on the plan.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;PensionPlan">
		<rdfs:subClassOf rdf:resource="&fibo-fnd-agr-ctr;WrittenContract"/>
		<rdfs:subClassOf rdf:resource="&fibo-sec-fund-pp;RetirementArrangement"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&fibo-sec-fund-pp;isFundedBy"/>
				<owl:onClass rdf:resource="&fibo-sec-fund-fund;PensionFund"/>
				<owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">0</owl:minQualifiedCardinality>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&cmns-doc;specifies"/>
				<owl:someValuesFrom rdf:resource="&fibo-sec-fund-pp;PensionAccount"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label>pension plan</rdfs:label>
		<dct:source>Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf.</dct:source>
		<skos:definition>legally binding contract having an explicit retirement objective or - in order to satisfy tax related conditions or contract provisions - the benefits can not be paid at all or without a significant penalty unless the beneficiary is older than a legally defined retirement age</skos:definition>
		<cmns-av:explanatoryNote>A pension plan is a retirement arrangement that establishes conditions for contributions, accrual of pension benefits, or provision of pension benefits to members or beneficiaries, in other words.</cmns-av:explanatoryNote>
		<cmns-av:explanatoryNote>This contract may be part of a broader employment contract, it may be set forth in the plan rules or documents, or it may be required by law. The elements of the pension plan may be mandated by law or statute or set forth as pre-requisites for special tax treatment, as is the case for many tax qualified savings or retirement programmes designed to provide the plan&apos;s members and beneficiaries with an income after retirement. In addition to having an explicit retirement objective, pension plans may offer additional benefits, such as disability, sickness, and survivors benefits.</cmns-av:explanatoryNote>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;RetirementAccount">
		<rdfs:subClassOf rdf:resource="&fibo-fbc-pas-caa;InvestmentOrDepositAccount"/>
		<rdfs:label>retirement account</rdfs:label>
		<skos:definition>account in which amounts intended to provide income or financial resources during retirement are recorded</skos:definition>
		<skos:note>The term &apos;amounts&apos; is used intentionally here as the account is the record, not necessarily the assets themselves, and because &apos;amounts&apos; can encompass balances or entitlements that do not correspond to a separately segregated pool of assets.</skos:note>
	</owl:Class>
	
	<owl:Class rdf:about="&fibo-sec-fund-pp;RetirementArrangement">
		<rdfs:subClassOf rdf:resource="&fibo-fnd-agr-agr;Agreement"/>
		<rdfs:label>retirement arrangement</rdfs:label>
		<skos:definition>arrangement that establishes conditions for the accumulation or provision of financial resources for retirement</skos:definition>
	</owl:Class>

</rdf:RDF>