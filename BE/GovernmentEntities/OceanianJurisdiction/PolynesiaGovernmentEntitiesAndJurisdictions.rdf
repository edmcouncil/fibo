		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/RegulatoryAgencies/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/"/>
		<owl:versionIRI rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/20261001/GovernmentEntities/OceanianJurisdiction/PolynesiaGovernmentEntitiesAndJurisdictions/"/>
		<skos:scopeNote>The initial version of this ontology reflects the national level only.</skos:scopeNote>
		<fibo-fnd-utl-av:hasMaturityLevel rdf:resource="&fibo-fnd-utl-av;Release"/>
		<cmns-av:copyright>Copyright (c) 2026 EDM Association dba EDM Council, Inc.</cmns-av:copyright>
	</owl:Ontology>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;GovernmentOfFrenchPolynesia">
		<rdf:type rdf:resource="&fibo-be-ge-ge;RegionalGovernment"/>
		<rdfs:label xml:lang="fr">Gouvernement de la Polynésie française</rdfs:label>
		<rdfs:label xml:lang="en">Government of French Polynesia</rdfs:label>
		<skos:definition>parliamentary representative democracy and overseas collectivity of France in Polynesia, consisting of one hundred eighteen islands and atolls in five archipelagos, including the Society Islands, in the South Pacific Ocean</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;FrenchPolynesia"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-polj;JurisdictionOfFrenchPolynesia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;GovernmentOfNiue">
		<rdf:type rdf:resource="&fibo-be-ge-ge;RegionalGovernment"/>
		<rdfs:label xml:lang="en">Government of Niue</rdfs:label>
		<skos:definition>parliamentary constitutional monarchy and self-governing territory in free association with New Zealand, located in Polynesia, consisting of a single raised coral island in the South Pacific Ocean, located east of Tonga</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Niue"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-polj;JurisdictionOfNiue"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;GovernmentOfTheCookIslands">
		<rdf:type rdf:resource="&fibo-be-ge-ge;RegionalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Cook Islands</rdfs:label>
		<skos:definition>parliamentary constitutional monarchy and self-governing territory in free association with New Zealand, located in Polynesia, consisting of fifteen islands in the South Pacific Ocean, located northeast of New Zealand</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;CookIslands"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-polj;JurisdictionOfTheCookIslands"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;GovernmentOfTheIndependentStateOfSamoa">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Independent State of Samoa</rdfs:label>
		<rdfs:label xml:lang="sm">Malo Saʻoloto Tutoʻatasi o Sāmoa</rdfs:label>
		<skos:definition>unitary parliamentary republic in Polynesia, consisting of the two main islands of Savai&apos;i and Upolu and several smaller islands in the South Pacific Ocean, located west of American Samoa</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Samoa"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-polj;JurisdictionOfTheIndependentStateOfSamoa"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;GovernmentOfTheKingdomOfTonga">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Kingdom of Tonga</rdfs:label>
		<rdfs:label xml:lang="to">Puleʻanga Fakatuʻi ʻo Tonga</rdfs:label>
		<skos:definition>unitary parliamentary constitutional monarchy in Polynesia, an archipelago of some one hundred seventy islands in the South Pacific Ocean, located south of Samoa and east of Fiji</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Tonga"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-polj;JurisdictionOfTheKingdomOfTonga"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;GovernmentOfTuvalu">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of Tuvalu</rdfs:label>
		<skos:definition>unitary parliamentary constitutional monarchy in Polynesia, consisting of three reef islands and six atolls in the South Pacific Ocean, located north of Fiji, south of Kiribati, and west of Tokelau</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Tuvalu"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-polj;JurisdictionOfTuvalu"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;JurisdictionOfFrenchPolynesia">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of French Polynesia</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of French Polynesia, which is the system of courts, forming part of the French judicial system and including the Court of Appeal of Papeete, that interprets and applies the law in French Polynesia</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;FrenchPolynesia"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-polj;GovernmentOfFrenchPolynesia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;JurisdictionOfNiue">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of Niue</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Niue, which is the system of courts, including the High Court of Niue, that interprets and applies the law in Niue</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Niue"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-polj;GovernmentOfNiue"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;JurisdictionOfTheCookIslands">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Cook Islands</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of the Cook Islands, which is the system of courts, including the High Court and the Court of Appeal of the Cook Islands, with final appeal to the Judicial Committee of the Privy Council, that interprets and applies the law in the Cook Islands</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;CookIslands"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-polj;GovernmentOfTheCookIslands"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;JurisdictionOfTheIndependentStateOfSamoa">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Independent State of Samoa</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Samoa, which is the system of courts, including the Court of Appeal and the Supreme Court of Samoa, that interprets and applies the law in Samoa</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Samoa"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-polj;GovernmentOfTheIndependentStateOfSamoa"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;JurisdictionOfTheKingdomOfTonga">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Kingdom of Tonga</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Tonga, which is the system of courts, including the Court of Appeal and the Supreme Court of Tonga, that interprets and applies the law in Tonga</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Tonga"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-polj;GovernmentOfTheKingdomOfTonga"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;JurisdictionOfTuvalu">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of Tuvalu</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Tuvalu, which is the system of courts, including the High Court of Tuvalu, that interprets and applies the law in Tuvalu</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Tuvalu"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-polj;GovernmentOfTuvalu"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;RegionalStateOfFrenchPolynesia">
		<rdf:type rdf:resource="&fibo-be-ge-ge;RegionalSovereignty"/>
		<rdfs:label>regional state of French Polynesia</rdfs:label>
		<skos:definition>regional sovereignty and polity that is French Polynesia</skos:definition>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;FrenchPolynesia"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-polj;GovernmentOfFrenchPolynesia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;RegionalStateOfNiue">
		<rdf:type rdf:resource="&fibo-be-ge-ge;RegionalSovereignty"/>
		<rdfs:label>regional state of Niue</rdfs:label>
		<skos:definition>regional sovereignty and polity that is Niue</skos:definition>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;Niue"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-polj;GovernmentOfNiue"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;RegionalStateOfTheCookIslands">
		<rdf:type rdf:resource="&fibo-be-ge-ge;RegionalSovereignty"/>
		<rdfs:label>regional state of the Cook Islands</rdfs:label>
		<skos:definition>regional sovereignty and polity that is the Cook Islands</skos:definition>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;CookIslands"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-polj;GovernmentOfTheCookIslands"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;StateOfSamoa">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Samoa</rdfs:label>
		<skos:definition>sovereign state and polity that is Samoa</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Samoa"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-polj;GovernmentOfTheIndependentStateOfSamoa"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;StateOfTonga">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Tonga</rdfs:label>
		<skos:definition>sovereign state and polity that is Tonga</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Tonga"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-polj;GovernmentOfTheKingdomOfTonga"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-polj;StateOfTuvalu">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Tuvalu</rdfs:label>
		<skos:definition>sovereign state and polity that is Tuvalu</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Tuvalu"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-polj;GovernmentOfTuvalu"/>
	</owl:NamedIndividual>

</rdf:RDF>