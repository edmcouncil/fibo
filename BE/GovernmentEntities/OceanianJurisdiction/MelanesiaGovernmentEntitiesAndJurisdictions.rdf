		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/RegulatoryAgencies/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/"/>
		<owl:versionIRI rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/20261001/GovernmentEntities/OceanianJurisdiction/MelanesiaGovernmentEntitiesAndJurisdictions/"/>
		<skos:scopeNote>The initial version of this ontology reflects the national level only.</skos:scopeNote>
		<fibo-fnd-utl-av:hasMaturityLevel rdf:resource="&fibo-fnd-utl-av;Release"/>
		<cmns-av:copyright>Copyright (c) 2026 EDM Association dba EDM Council, Inc.</cmns-av:copyright>
	</owl:Ontology>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;GovernmentOfNewCaledonia">
		<rdf:type rdf:resource="&fibo-be-ge-ge;RegionalGovernment"/>
		<rdfs:label xml:lang="fr">Gouvernement de la Nouvelle-Calédonie</rdfs:label>
		<rdfs:label xml:lang="en">Government of New Caledonia</rdfs:label>
		<skos:definition>parliamentary representative democracy and sui generis collectivity of France in Melanesia, an archipelago in the southwestern Pacific Ocean comprising the main island of Grande Terre, the Loyalty Islands, and several smaller island groups, located east of Australia and southwest of Vanuatu</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;NewCaledonia"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-melj;JurisdictionOfNewCaledonia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;GovernmentOfSolomonIslands">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of Solomon Islands</rdfs:label>
		<skos:definition>unitary parliamentary constitutional monarchy in Melanesia, an archipelago of six major islands and over nine hundred smaller islands in the South Pacific Ocean, located east of Papua New Guinea and northwest of Vanuatu</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;SolomonIslands"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-melj;JurisdictionOfSolomonIslands"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;GovernmentOfTheIndependentStateOfPapuaNewGuinea">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Independent State of Papua New Guinea</rdfs:label>
		<rdfs:label xml:lang="tpi">Independen Stet bilong Papua Niugini</rdfs:label>
		<skos:definition>unitary parliamentary constitutional monarchy in Melanesia, occupying the eastern half of the island of New Guinea and numerous offshore islands, sharing a land border with Indonesia to the west and maritime borders with Australia to the south and Solomon Islands to the east</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;PapuaNewGuinea"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-melj;JurisdictionOfTheIndependentStateOfPapuaNewGuinea"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;GovernmentOfTheRepublicOfFiji">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Republic of Fiji</rdfs:label>
		<rdfs:label xml:lang="fj">Matanitu Tugalala o Viti</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://www.fiji.gov.fj/"/>
		<skos:definition>unitary parliamentary republic in Melanesia, an archipelago of more than three hundred islands in the South Pacific Ocean, the largest of which are Viti Levu and Vanua Levu, located north of New Zealand and east of Vanuatu</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Fiji"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-melj;JurisdictionOfTheRepublicOfFiji"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;GovernmentOfTheRepublicOfVanuatu">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Republic of Vanuatu</rdfs:label>
		<rdfs:label xml:lang="bi">Ripablik blong Vanuatu</rdfs:label>
		<rdfs:label xml:lang="fr">République de Vanuatu</rdfs:label>
		<skos:definition>unitary parliamentary republic in Melanesia, an archipelago of some eighty islands in the South Pacific Ocean, located east of northern Australia, northeast of New Caledonia, and southeast of Solomon Islands</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Vanuatu"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-melj;JurisdictionOfTheRepublicOfVanuatu"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;JurisdictionOfNewCaledonia">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of New Caledonia</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of New Caledonia, which is the system of courts, forming part of the French judicial system and including the Court of Appeal of Nouméa, that interprets and applies the law in New Caledonia</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;NewCaledonia"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-melj;GovernmentOfNewCaledonia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;JurisdictionOfSolomonIslands">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of Solomon Islands</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Solomon Islands, which is the system of courts, including the Court of Appeal and the High Court of Solomon Islands, that interprets and applies the law in Solomon Islands</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;SolomonIslands"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-melj;GovernmentOfSolomonIslands"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;JurisdictionOfTheIndependentStateOfPapuaNewGuinea">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Independent State of Papua New Guinea</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Papua New Guinea, which is the system of courts, including the Supreme Court of Papua New Guinea, that interprets and applies the law in Papua New Guinea</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;PapuaNewGuinea"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-melj;GovernmentOfTheIndependentStateOfPapuaNewGuinea"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;JurisdictionOfTheRepublicOfFiji">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Republic of Fiji</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Fiji, which is the system of courts, including the Supreme Court of Fiji, that interprets and applies the law in Fiji</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Fiji"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-melj;GovernmentOfTheRepublicOfFiji"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;JurisdictionOfTheRepublicOfVanuatu">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Republic of Vanuatu</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Vanuatu, which is the system of courts, including the Supreme Court and the Court of Appeal of Vanuatu, that interprets and applies the law in Vanuatu</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Vanuatu"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-melj;GovernmentOfTheRepublicOfVanuatu"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;RegionalStateOfNewCaledonia">
		<rdf:type rdf:resource="&fibo-be-ge-ge;RegionalSovereignty"/>
		<rdfs:label>regional state of New Caledonia</rdfs:label>
		<skos:definition>regional sovereignty and polity that is New Caledonia</skos:definition>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;NewCaledonia"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-melj;GovernmentOfNewCaledonia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;StateOfFiji">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Fiji</rdfs:label>
		<skos:definition>sovereign state and polity that is Fiji</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Fiji"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-melj;GovernmentOfTheRepublicOfFiji"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;StateOfPapuaNewGuinea">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Papua New Guinea</rdfs:label>
		<skos:definition>sovereign state and polity that is Papua New Guinea</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;PapuaNewGuinea"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-melj;GovernmentOfTheIndependentStateOfPapuaNewGuinea"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;StateOfSolomonIslands">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Solomon Islands</rdfs:label>
		<skos:definition>sovereign state and polity that is Solomon Islands</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;SolomonIslands"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-melj;GovernmentOfSolomonIslands"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-melj;StateOfVanuatu">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Vanuatu</rdfs:label>
		<skos:definition>sovereign state and polity that is Vanuatu</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Vanuatu"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-melj;GovernmentOfTheRepublicOfVanuatu"/>
	</owl:NamedIndividual>

</rdf:RDF>