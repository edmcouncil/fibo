		See https://opensource.org/licenses/MIT.</dct:license>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/RegulatoryAgencies/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/"/>
		<owl:versionIRI rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/20261001/GovernmentEntities/OceanianJurisdiction/AustraliaAndNewZealandGovernmentEntitiesAndJurisdictions/"/>
		<skos:scopeNote>The initial version of this ontology reflects the national level only.</skos:scopeNote>
		<fibo-fnd-utl-av:hasMaturityLevel rdf:resource="&fibo-fnd-utl-av;Release"/>
		<cmns-av:copyright>Copyright (c) 2026 EDM Association dba EDM Council, Inc.</cmns-av:copyright>
	</owl:Ontology>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-anzj;GovernmentOfNewZealand">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of New Zealand</rdfs:label>
		<rdfs:label xml:lang="mi">Te Kāwanatanga o Aotearoa</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://www.govt.nz/"/>
		<skos:definition>unitary parliamentary constitutional monarchy in Oceania, an island country in the southwestern Pacific Ocean consisting of the North Island, the South Island, and over seven hundred smaller islands, located east of Australia across the Tasman Sea</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;NewZealand"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-anzj;JurisdictionOfNewZealand"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-anzj;GovernmentOfTheCommonwealthOfAustralia">
		<rdf:type rdf:resource="&fibo-be-ge-ge;FederalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Commonwealth of Australia</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://www.australia.gov.au/"/>
		<skos:definition>federal parliamentary constitutional monarchy in Oceania, comprising the mainland of the Australian continent, the island of Tasmania, and numerous smaller islands, located between the Indian and Pacific oceans, whose neighbors include Indonesia, Timor-Leste, and Papua New Guinea to the north, Solomon Islands, Vanuatu, and New Caledonia to the northeast, and New Zealand to the southeast</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Australia"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-anzj;JurisdictionOfTheCommonwealthOfAustralia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-anzj;JurisdictionOfNewZealand">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of New Zealand</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://www.courtsofnz.govt.nz/"/>
		<skos:definition>jurisdiction of the judiciary of New Zealand, which is the system of courts, including the Supreme Court of New Zealand, that interprets and applies the law in New Zealand</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;NewZealand"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-anzj;GovernmentOfNewZealand"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-anzj;JurisdictionOfTheCommonwealthOfAustralia">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Commonwealth of Australia</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://www.hcourt.gov.au/"/>
		<skos:definition>jurisdiction of the judiciary of Australia, which is the system of federal, state, and territory courts, including the High Court of Australia, that interprets and applies the law in Australia</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Australia"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-anzj;GovernmentOfTheCommonwealthOfAustralia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-anzj;StateOfAustralia">
		<rdf:type rdf:resource="&fibo-be-ge-ge;FederatedSovereignty"/>
		<rdfs:label>state of Australia</rdfs:label>
		<skos:definition>federated sovereignty and polity that is Australia</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Australia"/>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;ChristmasIsland"/>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;CocosKeelingIslands"/>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;HeardIslandAndMcDonaldIslands"/>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;NorfolkIsland"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-anzj;GovernmentOfTheCommonwealthOfAustralia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-anzj;StateOfNewZealand">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of New Zealand</rdfs:label>
		<skos:definition>sovereign state and polity that is New Zealand</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;NewZealand"/>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;CookIslands"/>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;Niue"/>
		<fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="&lcc-3166-1;Tokelau"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-anzj;GovernmentOfNewZealand"/>
	</owl:NamedIndividual>

</rdf:RDF>