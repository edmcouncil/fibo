		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/"/>
		<owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/Commons/RegulatoryAgencies/"/>
		<owl:imports rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/"/>
		<owl:versionIRI rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/20261001/GovernmentEntities/OceanianJurisdiction/MicronesiaGovernmentEntitiesAndJurisdictions/"/>
		<skos:scopeNote>The initial version of this ontology reflects the national level only.</skos:scopeNote>
		<fibo-fnd-utl-av:hasMaturityLevel rdf:resource="&fibo-fnd-utl-av;Release"/>
		<cmns-av:copyright>Copyright (c) 2026 EDM Association dba EDM Council, Inc.</cmns-av:copyright>
	</owl:Ontology>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;GovernmentOfTheFederatedStatesOfMicronesia">
		<rdf:type rdf:resource="&fibo-be-ge-ge;FederalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Federated States of Micronesia</rdfs:label>
		<skos:definition>federal republic in Micronesia, in free association with the United States, consisting of the four states of Yap, Chuuk, Pohnpei, and Kosrae, spread across the western Pacific Ocean north of Papua New Guinea</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Micronesia"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-micj;JurisdictionOfTheFederatedStatesOfMicronesia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;GovernmentOfTheRepublicOfKiribati">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Republic of Kiribati</rdfs:label>
		<rdfs:label xml:lang="gil">Ribaberiki Kiribati</rdfs:label>
		<skos:definition>unitary parliamentary republic with an executive presidency in Micronesia, consisting of thirty-two atolls and one raised coral island dispersed over a vast area of the central Pacific Ocean, straddling the equator and the International Date Line</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Kiribati"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-micj;JurisdictionOfTheRepublicOfKiribati"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;GovernmentOfTheRepublicOfNauru">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Republic of Nauru</rdfs:label>
		<rdfs:label xml:lang="na">Ripublik Naoero</rdfs:label>
		<skos:definition>unitary parliamentary republic with an executive presidency in Micronesia, a single raised coral island in the central Pacific Ocean located just south of the equator, whose nearest neighbor is Banaba Island in Kiribati to the east</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Nauru"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-micj;JurisdictionOfTheRepublicOfNauru"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;GovernmentOfTheRepublicOfPalau">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="pau">Beluu er a Belau</rdfs:label>
		<rdfs:label xml:lang="en">Government of the Republic of Palau</rdfs:label>
		<skos:definition>unitary presidential republic in Micronesia, in free association with the United States, consisting of some three hundred forty islands in the western Pacific Ocean, located east of the Philippines and north of Indonesia</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;Palau"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-micj;JurisdictionOfTheRepublicOfPalau"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;GovernmentOfTheRepublicOfTheMarshallIslands">
		<rdf:type rdf:resource="&fibo-be-ge-ge;NationalGovernment"/>
		<rdfs:label xml:lang="en">Government of the Republic of the Marshall Islands</rdfs:label>
		<skos:definition>unitary parliamentary republic with an executive presidency in Micronesia, in free association with the United States, consisting of twenty-nine coral atolls and five islands in the central Pacific Ocean, located north of Nauru and Kiribati and east of the Federated States of Micronesia</skos:definition>
		<cmns-rga:governs rdf:resource="&lcc-3166-1;MarshallIslands"/>
		<cmns-rga:hasJurisdiction rdf:resource="&fibo-be-ge-micj;JurisdictionOfTheRepublicOfTheMarshallIslands"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;JurisdictionOfTheFederatedStatesOfMicronesia">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Federated States of Micronesia</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of the Federated States of Micronesia, which is the system of national and state courts, including the Supreme Court of the Federated States of Micronesia, that interprets and applies the law in the Federated States of Micronesia</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Micronesia"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-micj;GovernmentOfTheFederatedStatesOfMicronesia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;JurisdictionOfTheRepublicOfKiribati">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Republic of Kiribati</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Kiribati, which is the system of courts, including the High Court and the Court of Appeal of Kiribati, that interprets and applies the law in Kiribati</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Kiribati"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-micj;GovernmentOfTheRepublicOfKiribati"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;JurisdictionOfTheRepublicOfNauru">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Republic of Nauru</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Nauru, which is the system of courts, including the Supreme Court of Nauru and the Nauru Court of Appeal, that interprets and applies the law in Nauru</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Nauru"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-micj;GovernmentOfTheRepublicOfNauru"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;JurisdictionOfTheRepublicOfPalau">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Republic of Palau</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of Palau, which is the system of courts, including the Supreme Court of the Republic of Palau, that interprets and applies the law in Palau</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;Palau"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-micj;GovernmentOfTheRepublicOfPalau"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;JurisdictionOfTheRepublicOfTheMarshallIslands">
		<rdf:type rdf:resource="&cmns-rga;Jurisdiction"/>
		<rdfs:label>jurisdiction of the Republic of the Marshall Islands</rdfs:label>
		<skos:definition>jurisdiction of the judiciary of the Marshall Islands, which is the system of courts, including the Supreme Court of the Marshall Islands, that interprets and applies the law in the Marshall Islands</skos:definition>
		<cmns-rga:hasReach rdf:resource="&lcc-3166-1;MarshallIslands"/>
		<cmns-rga:isJurisdictionOf rdf:resource="&fibo-be-ge-micj;GovernmentOfTheRepublicOfTheMarshallIslands"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;StateOfKiribati">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Kiribati</rdfs:label>
		<skos:definition>sovereign state and polity that is Kiribati</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Kiribati"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-micj;GovernmentOfTheRepublicOfKiribati"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;StateOfMicronesia">
		<rdf:type rdf:resource="&fibo-be-ge-ge;FederatedSovereignty"/>
		<rdfs:label>state of Micronesia</rdfs:label>
		<skos:definition>federated sovereignty and polity that is the Federated States of Micronesia</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Micronesia"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-micj;GovernmentOfTheFederatedStatesOfMicronesia"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;StateOfNauru">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Nauru</rdfs:label>
		<skos:definition>sovereign state and polity that is Nauru</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Nauru"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-micj;GovernmentOfTheRepublicOfNauru"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;StateOfPalau">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of Palau</rdfs:label>
		<skos:definition>sovereign state and polity that is Palau</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;Palau"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-micj;GovernmentOfTheRepublicOfPalau"/>
	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="&fibo-be-ge-micj;StateOfTheMarshallIslands">
		<rdf:type rdf:resource="&fibo-be-ge-ge;SovereignState"/>
		<rdfs:label>state of the Marshall Islands</rdfs:label>
		<skos:definition>sovereign state and polity that is the Marshall Islands</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="&lcc-3166-1;MarshallIslands"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="&fibo-be-ge-micj;GovernmentOfTheRepublicOfTheMarshallIslands"/>
	</owl:NamedIndividual>

</rdf:RDF>